<!-- Retro Pixel Font -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">

<style>
    /* Bright Sunny RPG Palette */
    :root {
        --sky-blue: #5cceff;
        --grass-green: #5cd670;
        --window-bg: #fffbf0; /* Warm cream page */
        --border-dark: #2c2c35;
        --text-dark: #2c2c35;
        --text-muted: #62627a;
        
        /* Fruit & Item Colors */
        --pixel-apple: #ff3b3b;
        --pixel-grape: #9b5de5;
        --pixel-orange: #f15bb5;
        --pixel-gold: #fee440;
        --pixel-leaf: #00f5d4;
    }

    body {
        background-color: var(--sky-blue);
        /* Pixel Art Grass Horizon at the bottom */
        background-image: linear-gradient(to top, var(--grass-green) 40px, transparent 40px);
        color: var(--text-dark);
        font-family: 'Press Start 2P', monospace;
        font-size: 11px;
        line-height: 1.8;
        margin: 0;
        padding: 40px 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        box-sizing: border-box;
        position: relative;
    }

    /* Pure CSS Pixel Clouds in the background */
    body::before {
        content: "";
        position: absolute;
        top: 10%;
        left: 10%;
        width: 120px;
        height: 30px;
        background: white;
        box-shadow: 30px 10px 0 0 white, -20px 10px 0 0 white, 10px -10px 0 0 white;
        opacity: 0.6;
        z-index: 0;
    }

    /* Main Cozy Game Menu UI Window */
    .game-container {
        width: 100%;
        max-width: 950px;
        background-color: var(--window-bg);
        border: 6px solid var(--border-dark);
        box-shadow: 12px 12px 0px rgba(0, 0, 0, 0.15);
        padding: 25px;
        z-index: 10;
        position: relative;
        border-radius: 4px;
    }

    /* Top Banner Header */
    .game-header {
        text-align: center;
        border-bottom: 6px double var(--border-dark);
        padding-bottom: 20px;
        margin-bottom: 30px;
        position: relative;
    }

    .game-header h1 {
        font-size: 20px;
        margin: 0 0 12px 0;
        color: #ff5964;
        text-shadow: 2px 2px 0px var(--pixel-gold);
        text-transform: uppercase;
    }

    .status-hud {
        font-size: 8px;
        background: #eef7fc;
        display: inline-block;
        padding: 8px 16px;
        border: 3px solid var(--border-dark);
        color: var(--text-dark);
        line-height: 1.6;
    }

    /* Main Interactive Layout Grid */
    .menu-layout {
        display: flex;
        flex-direction: row;
        gap: 25px;
    }

    /* Sidebar Buttons */
    .tabs-sidebar {
        width: 34%;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .tab-btn {
        background-color: #ffeaa7;
        color: var(--text-dark);
        border: 4px solid var(--border-dark);
        padding: 12px 10px;
        font-family: 'Press Start 2P', monospace;
        font-size: 8px;
        text-align: left;
        cursor: pointer;
        box-shadow: 4px 4px 0px var(--border-dark);
        transition: all 0.1s ease;
    }

    .tab-btn:hover {
        background-color: #ffffcc;
        transform: translate(2px, 2px);
        box-shadow: 2px 2px 0px var(--border-dark);
    }

    /* Active Tab Accent (Selected Level) */
    .tab-btn.active {
        background-color: #ff7675;
        color: white;
        box-shadow: none;
        transform: translate(4px, 4px);
    }

    /* Monitor Display Box */
    .display-panel {
        width: 66%;
        background-color: #ffffff;
        border: 4px solid var(--border-dark);
        padding: 25px;
        min-height: 440px;
        box-sizing: border-box;
        box-shadow: inset 4px 4px 0px rgba(0,0,0,0.05);
    }

    .tab-content {
        display: none;
    }

    .tab-content.active {
        display: block;
    }

    h2 {
        font-size: 11px;
        color: #0984e3;
        margin-top: 0;
        margin-bottom: 20px;
        text-transform: uppercase;
        border-bottom: 4px dashed #dfe6e9;
        padding-bottom: 10px;
    }

    p {
        color: var(--text-muted);
        font-size: 10px;
        line-height: 1.8;
    }

    /* Pixel Fruit Bullet Points Rules */
    ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    li {
        font-size: 10px;
        margin-bottom: 16px;
        position: relative;
        padding-left: 24px;
        color: var(--text-muted);
        line-height: 1.6;
    }

    /* Custom Pixel Icons built directly into list bullets */
    li::before {
        content: "🍒";
        position: absolute;
        left: 0;
        top: -2px;
        font-size: 12px;
    }

    .apple-list li::before { content: "🍎"; }
    .grape-list li::before { content: "🍇"; }
    .coin-list li::before { content: "🪙"; }
    .star-list li::before { content: "⭐"; }
    .banana-list li::before { content: "🍌"; }

    .highlight {
        color: var(--text-dark);
        font-weight: bold;
    }

    /* Grid box inside skills */
    .perks-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
        margin-top: 10px;
    }
    
    .perk-box {
        background: #f9f9ff;
        border: 3px solid var(--border-dark);
        padding: 10px;
        font-size: 9px;
        line-height: 1.6;
    }

    @media (max-width: 768px) {
        .menu-layout { flex-direction: column; }
        .tabs-sidebar, .display-panel { width: 100%; }
    }
</style>
